{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "jsxImportSource": "orca",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "preserveSymlinks": true,
    "typeRoots": [
      "."
    ],
    "types": [
      "orca",
      "orca-host",
      "orca-frame",
      "orca-worker",
      "orca-services",
      "orca-testing"
    ]
  }
}
